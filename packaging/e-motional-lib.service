[Unit]
Description=e-motional-lib isolated touchpad edge motion worker
Requires=e-motional-lib-broker.socket
After=e-motional-lib-broker.socket
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
User=e-motional-lib
OpenFile=/run/e-motional-lib/broker.sock:broker
ExecStart=/usr/bin/e-motional-lib --worker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
TemporaryFileSystem=/etc:ro /run:ro /var:ro
BindReadOnlyPaths=-/etc/ld.so.cache
InaccessiblePaths=/sys
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

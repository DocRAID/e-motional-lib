[Unit]
Description=e-motional-lib minimal root device broker
Requires=e-motional-lib-broker.socket
BindsTo=systemd-logind.service
Wants=modprobe@uinput.service
After=e-motional-lib-broker.socket systemd-logind.service modprobe@uinput.service
PartOf=e-motional-lib.service
ConditionPathExists=/etc/e-motional-lib/config.toml
ConditionPathExists=/dev/uinput
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/e-motional-lib --broker
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
BindReadOnlyPaths=/dev/input
BindPaths=/dev/uinput
TemporaryFileSystem=/etc:ro /run:ro /var:ro
BindReadOnlyPaths=/etc/e-motional-lib
BindReadOnlyPaths=-/etc/ld.so.cache
BindReadOnlyPaths=/run/e-motional-lib
BindReadOnlyPaths=-/run/udev
BindReadOnlyPaths=-/run/systemd/seats -/run/systemd/sessions -/run/systemd/users
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
